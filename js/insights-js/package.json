{
  "name": "@devstrike/insights-js",
  "version": "0.1.0",
  "description": "Henosis Insights client for JavaScript SDKs: React Native packages, web SDKs, Node packages. Integration telemetry with no end-user data.",
  "license": "Apache-2.0",
  "author": "Devstrike Digital Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devstrike-DigTech/henosis-insights.git",
    "directory": "js/insights-js"
  },
  "keywords": [
    "telemetry",
    "sdk",
    "privacy",
    "react-native",
    "henosis"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "react-native": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.e2e.test.ts'",
    "test:e2e": "vitest run test/ingest.e2e.test.ts",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
